PORT=8787
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_AGENT_MODEL=
DEFAULT_PROVIDER=openai-agents

# Persistent SaaS control plane. docker-compose overrides the host to `postgres`.
DATABASE_URL=postgres://agent_gateway:agent_gateway_local@localhost:5432/agent_gateway
AGENT_GATEWAY_AUTO_MIGRATE=true
AGENT_GATEWAY_DEV_BOOTSTRAP=true
AGENT_GATEWAY_DEV_KEY=ag_dev_local
AGENT_GATEWAY_ADMIN_TOKEN=admin_dev_local
AGENT_GATEWAY_IDEMPOTENCY_PENDING_TTL_SECONDS=900
AGENT_GATEWAY_IDEMPOTENCY_TTL_SECONDS=86400

# Hot-path runtime state. Required in production; docker-compose overrides the host to `redis`.
REDIS_URL=redis://localhost:6379
AGENT_GATEWAY_REDIS_PREFIX=agent-gateway
AGENT_GATEWAY_SESSION_CACHE_TTL_SECONDS=300
AGENT_GATEWAY_RATE_LIMIT_REQUESTS=120
AGENT_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
AGENT_GATEWAY_MAX_CONCURRENCY=20
AGENT_GATEWAY_CONCURRENCY_LEASE_SECONDS=300
AGENT_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=3
AGENT_GATEWAY_CIRCUIT_FAILURE_WINDOW_SECONDS=60
AGENT_GATEWAY_CIRCUIT_OPEN_SECONDS=30

# Used only when DATABASE_URL is unset in local development.
AGENT_GATEWAY_KEYS=[{"id":"vk_dev","key":"ag_dev_local","tenantId":"tenant_dev","projectId":"project_dev","enabled":true}]

# Optional path to a JSON config with a `channels` array.
# AGENT_GATEWAY_CONFIG=./config/channels.example.json
