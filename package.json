{
  "name": "agent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic agent runtime gateway with pluggable Agents API adapters.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
