{
  "name": "agent-gateway",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source Agent API gateway for routing, tenancy, session affinity, metering and billing across agent runtimes.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "dev": "npm run build && node apps/server/dist/index.js",
    "start": "node apps/server/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=22" }
}
